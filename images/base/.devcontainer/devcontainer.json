{
  "name": "base",
  "dockerFile": "Dockerfile",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true,
      "username": "none"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {
      "yqVersion": "4"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/mrsimonemms/devcontainers/diff-so-fancy:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "donjayamanne.git-extension-pack",
        "EditorConfig.EditorConfig",
        "waderyan.gitblame",
        "GitHub.vscode-github-actions",
        "ms-vscode.makefile-tools",
        "ms-vsliveshare.vsliveshare",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions"
      }
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.claude",
      "target": "/home/vscode/.claude",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.codex",
      "target": "/home/vscode/.codex",
      "type": "bind"
    }
  ],
  "initializeCommand": {
    "init-claude": "mkdir -p ${localEnv:HOME}${localEnv:USERPROFILE}/.claude",
    "init-codex": "mkdir -p ${localEnv:HOME}${localEnv:USERPROFILE}/.codex"
  },
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode",
  "postCreateCommand": {
    "docker-completion": "docker completion bash | sudo tee -a /etc/bash_completion.d/docker > /dev/null"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
}
